  "narrative": {
    "northStar": "Kamu Arşivi Atölyesi",
    "overview": "Enstitü Sosyal'in portalı, bir kamu arşivinin çalışma masası gibi davranır: krem bir zeminde düzenli, ince çizgili kartlar ve tek bir bordo-kırmızı ses. Bilgi önde durur, süs geri planda kalır.",
    "keyCharacteristics": [
      "Krem kâğıt zemin, beyaz kartlar, ince sıcak gri kenarlık.",
      "Bordo birincil eylem ve başlık rengi; kırmızı küçük vurgu ve etkileşim rengi.",
      "Başlıkta ClashDisplay, gövdede Satoshi.",
      "Yuvarlak ama gösterişsiz köşeler: düğme ve arama hap biçimli, kartlar 14 px.",
      "Düz yüzeyler; gölge yalnız açılır katmanda ve üzerine gelinen kartta."
    ],
    "rules": [
      {
        "name": "Tek Ses Kuralı",
        "body": "Bordo ve kırmızı sayfanın azınlığında kalır; bir ekranda yüzeyin büyük kısmı krem ve beyazdır.",
        "section": "colors"
      },
      {
        "name": "Bordo Eylemdir Kuralı",
        "body": "Bordo dolgu yalnız bir eylemi ya da en önemli aracı işaretler.",
        "section": "colors"
      },
      {
        "name": "İki Aile Kuralı",
        "body": "Başlıkta yalnız ClashDisplay, gövdede yalnız Satoshi; üçüncü bir aile eklenmez.",
        "section": "typography"
      },
      {
        "name": "Gölge Tepkidir Kuralı",
        "body": "Yüzey sakin durumda gölgesizdir; gölge yalnız açılan bir katmanı ya da üzerine gelinen bir kartı ayırır.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do bordoyu (#721530) başlık ve birincil eylem için, kırmızıyı (#d1181e) küçük vurgu için kullan.",
      "Do kartları beyaz zeminde 1 px sıcak çizgiyle ayır; derinlik için önce çizgi ve zemin farkı.",
      "Do başlıkta ClashDisplay 600, gövdede Satoshi kullan.",
      "Do düğmeleri hap biçiminde (30 px) tut. Üst çubukta \"Veri portalına git\" çizgili, \"Giriş yap\" dolgulu bordodur.",
      "Do henüz hazır olmayan şeyi kesikli çerçeve ve \"yakında\" etiketiyle göster; hazır gibi sunma.",
      "Do haritada portaldaki beş sınıflı renk skalasını kullan."
    ],
    "donts": [
      "Don't limon yeşili (#cfff45) kullanma.",
      "Don't haritada seçili ile siyah çerçeve çizme; seçili il kendi tonunun koyusuna döner.",
      "Don't sakin yüzeye gölge ekleme; gölge yalnız açılan katmanda ve üzerine gelinen kartta.",
      "Don't üçüncü bir yazı tipi ailesi ekleme.",
      "Don't emoji ya da Unicode karakterleri simge yerine kullanma; tek çizgi stilinde SVG simge kullan.",
      "Don't başlığın üstüne küçük etiket (kicker) koyma; başlık tek başına taşır.",
      "Don't yuvarlak kartın tek kenarına renkli çizgi çekme.",
      "Don't hazır olmayan öğeyi yarı saydam gösterme; kesikli çerçeveli, tam kontrastlı kartla ve \"yakında\" etiketiyle belirt."
    ]
  }
}